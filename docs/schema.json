{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://downcroc.dev/schema/docs-page.json",
  "title": "Downcroc documentation page",
  "description": "Frontmatter contract for one page in the Downcroc documentation book.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "audience", "status"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Page title. Must match the first H1."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One sentence used by browser meta tags and terminal search."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 32 },
      "uniqueItems": true,
      "default": []
    },
    "audience": {
      "enum": ["user", "operator", "developer", "security"]
    },
    "status": {
      "enum": ["draft", "stable", "deprecated", "internal"],
      "default": "stable"
    },
    "since": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[a-z]+[0-9]+)?$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_./-]+\\.md$" },
      "uniqueItems": true,
      "default": []
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "max_width": { "type": "integer", "minimum": 40, "maximum": 160 },
        "toc": { "type": "boolean", "default": true }
      },
      "default": {}
    },
    "search_boost": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5.0,
      "default": 1.0
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_./-]+$" },
      "uniqueItems": true,
      "default": []
    }
  }
}
